  "cards": [
    {
      "dot": "emerald",
      "title": "Luồng RAG Retrieval & Trích dẫn",
      "items": [
        "ChatController tiếp nhận câu hỏi qua API POST không làm reload trang web",
        "RagEngineService tìm kiếm Chunks theo thuật toán TF-IDF và Term Overlap",
        "Top 4 Chunks có điểm cao nhất được trích xuất thành CitationDto kèm số trang"
      ]
    },
    {
      "dot": "amber",
      "title": "Kiểm soát Hạn ngạch (Quota Gate)",
      "items": [
        "Tự động kiểm tra reset số lượt dùng về 0 khi sang ngày mới",
        "Chặn người dùng Free khi chạm trần 50 câu/ngày, bảo vệ tài nguyên máy chủ",
        "Người dùng Pro được chat không giới hạn và mở khóa đầy đủ tính năng"
      ]
    },
    {
      "dot": "rose",
      "title": "Xoay vòng Multi-Key & Phục hồi lỗi",
      "items": [
        "LlmKeyRotator điều phối nhiều Gemini API Keys theo cơ chế Round-Robin",
        "Tự động đưa Key gặp lỗi 429 (Rate Limit) vào thời gian Cooldown 60 giây",
        "Toàn bộ lịch sử trao đổi của sinh viên và AI được lưu bền vững vào Database"
      ]
    }
  ]
