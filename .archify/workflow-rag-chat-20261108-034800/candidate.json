  "cards": [
    {
      "dot": "cyan",
      "title": "Hạn ngạch & Early Return",
      "items": [
        "ChatController kiểm tra phiên đăng nhập và tự động reset dailyRagCount về 0 khi sang ngày mới",
        "Sinh viên gói FREE bị chặn ở ngưỡng 50 câu/ngày, bảo vệ ngân sách API và tài nguyên hệ thống",
        "Khi hết hạn ngạch, hệ thống trả về thông báo nâng cấp Pro ngay lập tức mà không tiêu tốn tài nguyên RAG"
      ]
    },
    {
      "dot": "rose",
      "title": "Tìm kiếm RAG & Dự phòng Nội dung",
      "items": [
        "RagEngineService trích xuất từ khóa loại bỏ stop words tiếng Việt và tiếng Anh",
        "Tính điểm độ liên quan kết hợp khớp chuỗi trực tiếp (+10) và log tần suất từ khóa",
        "Cơ chế dự phòng: Nếu không tìm thấy đoạn văn bản liên quan, tự động nạp 4 đoạn đầu tiên của giáo trình"
      ]
    },
    {
      "dot": "amber",
      "title": "Cơ chế Tự phục hồi LLM (Failover)",
      "items": [
        "LlmKeyRotator chọn API Key theo Round-Robin và tự động bỏ qua các Key đang bị Cooldown",
        "Khi gặp lỗi HTTP 429 hoặc Resource Exhausted, Key được đưa vào Cooldown 60 giây và xoay sang Key kế tiếp",
        "Thử tuần tự danh sách 6 mô hình Gemini và lưu trữ câu trả lời kèm Clean RAG Context vào DB"
      ]
    }
  ]
