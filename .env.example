# ===================================================================
# 🎓 SMART STUDYHUB RAG - CẤU HÌNH BIẾN MÔI TRƯỜNG DÀNH CHO CÁC THÀNH VIÊN
# ===================================================================
# Hướng dẫn sử dụng:
# 1. Tạo bản sao của file này và đặt tên là: .env
# 2. Điền các giá trị thực tế bên dưới. File .env đã được cấu hình trong .gitignore,
#    sẽ không bao giờ bị đẩy lên GitHub, đảm bảo an toàn bảo mật tuyệt đối!
# 3. Khi chạy ứng dụng, Spring Boot sẽ tự động nạp cấu hình từ file .env.
# ===================================================================

# -------------------------------------------------------------------
# 1. CẤU HÌNH ĐĂNG NHẬP GOOGLE OAUTH2 (Phân hệ Auth - Trường)
# -------------------------------------------------------------------
# Link tạo miễn phí: https://console.cloud.google.com/apis/credentials
# - Authorized JavaScript origins: http://localhost:8080
# - Authorized redirect URIs: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# -------------------------------------------------------------------
# 2. CẤU HÌNH GOOGLE GEMINI AI API (Phân hệ AI Chat, Quiz, Planner)
# -------------------------------------------------------------------
# Link lấy API Key miễn phí (Google AI Studio): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
